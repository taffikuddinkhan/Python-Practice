   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = [1,2,3,4,5]\n",
    "y=[]\n",
    "\n",
    "for i in x :\n",
    "    y.append(2*i+3)\n",
    "\n",
    "plt.plot(x,y)\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")    \n",
    "plt.title(\"Linear Equation\",color=\"r\")"
   ]
  }
